# --- Jahia ---
SUPER_USER_PASSWORD=${SUPER_USER_PASSWORD:-root1234}
TIMEZONE=${TIMEZONE:-Europe/Paris}
MCP_ENABLED=false
MCP_API_TOKEN=changeme
JPDA=true

# --- Database ---
DB_NAME=jahia
DB_USER=jahia
DB_PASS=dbpassword

# --- Mail (internal Docker network, not the published host port) ---
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025

# --- Hostnames (require no /etc/hosts changes on most systems) ---
JAHIA_HOST=prism.localhost
MAILPIT_HOST=mailpit.localhost
TRAEFIK_HOST=traefik.localhost

# --- Ports ---
HTTP_PORT=80
HTTPS_PORT=443
JAHIA_HTTP_PORT=8080
JAHIA_DEBUG_PORT=9229
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Image versions ---
JAHIA_IMAGE=achaabni/jahia-prism:0.1.1
POSTGRES_IMAGE=postgres:16
MAILPIT_IMAGE=axllent/mailpit:latest
TRAEFIK_IMAGE=traefik:v3.7.6
ALPINE_IMAGE=alpine:3.20
